{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/guard.py\" || exit 2",
            "timeout": 40,
            "onFailure": "block",
            "statusMessage": "Ploni guard"
          }
        ]
      }
    ]
  }
}
