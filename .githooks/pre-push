#!/bin/sh
# The check before a push (PROCESS.md section 12 item 8; Achia, 2026-11-20, issue #174): the fast
# suite, scripts/check.py, and a red result stops the push. Git runs it once
# `git config core.hooksPath .githooks` is set in the clone. The suite reads the files of the
# checkout it runs in, so the push is refused unless what it sends is what the suite reads: no
# change not committed, and every ref sent names the checkout's HEAD: the commit itself, or a tag
# of it (a deleted ref sends nothing).
# The project's environment first, as the check before a commit finds it: this folder's .venv,
# then the .venv of the main checkout, for a worktree.
# Known limits: a clone without core.hooksPath set runs none of it, and `git push --no-verify`
# skips it; the merge gate's hook refuses that flag to Claude (scripts/guard.py), and the fast
# suite in CI runs on the PR. A hook is speed, not safety (PROMOTION.md, Level 0). A tag
# of another commit, sent with its branch, is refused: check that commit out and send it alone.
common="$(git rev-parse --git-common-dir 2>/dev/null)"
head="$(git rev-parse HEAD)"
if [ -n "$(git status --porcelain)" ]; then
    echo "check before push: the checkout has changes not committed; commit or stash them first" >&2
    exit 1
fi
while read -r ref sha rest; do
    case "$sha" in
        *[!0]*) if [ "$(git rev-parse -q --verify "$sha^{commit}")" != "$head" ]; then
                echo "check before push: $ref does not name the checkout's HEAD; check out what it names to send it" >&2
                exit 1
            fi ;;
    esac
done
# git sets GIT_DIR for a hook in a worktree, and `git -c` sets GIT_CONFIG_PARAMETERS. Passed on to
# the suite, a test's git command in a temporary folder reached this repository instead: on
# 2026-11-20 its `git init --bare` made the repository bare (tests/t4_integration/test_pre_push.py,
# A1 and A2). So the suite starts without every variable git lists as the repository's own.
unset $(git rev-parse --local-env-vars)
for python in .venv/Scripts/python.exe .venv/bin/python "$common/../.venv/Scripts/python.exe" "$common/../.venv/bin/python"; do
    if [ -x "$python" ]; then exec "$python" scripts/check.py; fi
done
echo "check before push: no .venv found here or in the main checkout; trying python on PATH" >&2
exec python scripts/check.py
